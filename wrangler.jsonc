{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Serves the Next.js static export in out/. Requests to static assets are free and unlimited
  // on Workers; worker/index.js only runs for the run_worker_first paths below.
  "name": "bradleygrantham-com",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-08",
  // Cloudflare creates the DNS records and certificates for these on deploy. The www -> root
  // redirect is a Redirect Rule in the dashboard, not part of this Worker.
  "routes": [
    { "pattern": "bradleygrantham.com", "custom_domain": true },
    { "pattern": "www.bradleygrantham.com", "custom_domain": true }
  ],
  // Keep the workers.dev copy as a preview (Wrangler turns it off by default once routes exist).
  "workers_dev": true,
  // The MCP server (mcp/), a separate Python Worker, reached only through this binding.
  "services": [{ "binding": "MCP", "service": "bradleygrantham-mcp" }],
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    // /mcp: POST goes to the MCP Worker, browsers get the landing page. Everything else is
    // plain static assets.
    "run_worker_first": ["/mcp"],
    // /about and /about/ both serve about/index.html (matches trailingSlash in next.config.ts)
    "html_handling": "auto-trailing-slash",
    // Unknown paths get out/404.html with a 404 status
    "not_found_handling": "404-page"
  }
}
